# FriendLoop Environment Configuration

# -- Server Configuration --
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:28017

# -- Secrets --
JWT_SECRET=super_secret_jwt_key_here

# -- Database Connections --
# PostgreSQL (Relational Data: Users, Friendships)
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=friendloop

# MongoDB (Document Data: Posts, Comments, Messages)
MONGO_URI=mongodb://localhost:28071/friendloop

# Redis (Caching & Sessions)
REDIS_URL=redis://localhost:6379

# -- Client Configuration (.env.local for Next.js) --
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
